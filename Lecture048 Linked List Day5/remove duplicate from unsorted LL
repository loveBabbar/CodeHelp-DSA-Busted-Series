void deleteduplicate(Node* head) {
    Node * temp=head;
    while (temp!=NULL) {
        Node* temp2=temp;
        while (temp2!=NULL) {
            if ((temp2->next!=NULL) &&temp2->next->data==temp->data) {
                Node* nodetodel=temp2->next;
                if (temp2->next->next!=NULL) {
                    temp2->next=temp2->next->next;

                }
                else {
                    temp2->next=NULL;

                }
                
                
                delete nodetodel;

            }
            else {
                temp2=temp2->next;
            }
            

        }
        temp=temp->next;
    }
}
