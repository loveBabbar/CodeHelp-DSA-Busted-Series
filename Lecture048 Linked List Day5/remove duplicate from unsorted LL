    map<int,bool> visited;
    Node*curr=head;
    Node* prev=NULL;
    while(curr!=NULL) {
        if(visited[curr->data]==true) {
            prev->next=curr->next;
            Node* pointerforcurr=curr->next;
            delete curr;
            
            
            curr=pointerforcurr;
            

        }
        else {
            visited[curr->data]=true;
